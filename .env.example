# =============================================================================
# .env.example — variables d'environnement attendues par l'application.
#
# AVERTISSEMENT : ce fichier ne contient AUCUNE valeur secrète réelle.
#   1. copiez-le en `.env` à la racine du projet (`.env` est ignoré par git) ;
#   2. renseignez des valeurs LOCALES, jamais commitées ;
#   3. l'application échoue au démarrage si une variable obligatoire manque.
#
# Générer une clé maîtresse AES-256 (32 octets en base64) :
#   cd src && ../.venv/bin/python -m app.config
# =============================================================================

# -----------------------------------------------------------------------------
# OBLIGATOIRES
# -----------------------------------------------------------------------------

# Chaîne de connexion PostgreSQL (locale, jamais exposée sur Internet).
# Exemple local (Postgres.app, authentification « trust » sur localhost) :
DATABASE_URL=postgresql://UTILISATEUR@127.0.0.1:5432/ia_consultations

# Clé MAÎTRESSE du chiffrement applicatif, encodée en base64 (32 octets exactement).
# Elle permet de dériver, par client, la clé de données (HKDF) — voir annexe A § A6.
# NE JAMAIS committer de valeur réelle.
CLE_CHIFFREMENT_MAITRESSE=

# Secret de signature du cookie de session (chaîne aléatoire longue).
# Une valeur de production se génère par ex. avec : openssl rand -base64 48
CLE_SESSION=

# -----------------------------------------------------------------------------
# OPTIONNELLES (valeurs par défaut sûres)
# -----------------------------------------------------------------------------

# Interface d'écoute de l'API. 127.0.0.1 = local uniquement (rien d'exposé).
HOTE_API=127.0.0.1
PORT_API=8000

# Répertoire de stockage des pièces, HORS DÉPÔT (ignoré par git).
REPERTOIRE_DOCUMENTS=data

# Durée de vie d'une session, en secondes (défaut : 24 h).
DUREE_SESSION_SECONDES=86400

# -----------------------------------------------------------------------------
# SAUVEGARDE ET RESTAURATION (scripts/sauvegarde.sh, scripts/restauration.sh)
# -----------------------------------------------------------------------------
# Ces variables concernent les scripts d'exploitation, pas l'application.
# Elles se placent de préférence dans l'environnement du serveur, pas ici.
#
# Répertoire de sauvegarde, HORS DÉPÔT (les scripts refusent un chemin dans le
# dépôt). Défaut : $HOME/sauvegardes-ia-consultations
SAUVEGARDE_REPERTOIRE=
#
# Fichier contenant la clé de chiffrement des sauvegardes, HORS DÉPÔT,
# permissions 600 exigées. Défaut : $HOME/.config/ia-consultations/cle-sauvegarde
# AUCUNE VALEUR ICI : ce fichier contient la clé, il n'est pas versionné.
SAUVEGARDE_CLE_FICHIER=
#
# Répertoire de restauration des fichiers (en clair), HORS DÉPÔT.
# Défaut : $HOME/restauration-ia-consultations/documents
RESTAURATION_REPERTOIRE=

# -----------------------------------------------------------------------------
# ANALYSE DE DCE (brique B) — L3
# -----------------------------------------------------------------------------

# Fournisseur de modèle employé (décision D8).
#   factice (DÉFAUT) : règles de lecture déterministes, SANS réseau et SANS modèle de
#                      langage — c'est le fournisseur des tests, et il ne « comprend » rien.
#   ue               : appel HTTP à un fournisseur établi en France ou dans l'UE.
# Aucun appel réseau n'est effectué tant que cette variable vaut `factice`.
MODELE_FOURNISSEUR=factice

# --- Fournisseur réel France/UE : renseigner UNIQUEMENT en usage réel -----------------
# Adresse complète de l'endpoint, compatible OpenAI (exemples réels, sans clé) :
#   Mistral AI          : https://api.mistral.ai/v1/chat/completions
#   OVHcloud AI Endpoints : https://oai.endpoints.kepler.ai.cloud.ovh.net/v1/chat/completions
MODELE_FOURNISSEUR_URL=
# Clé d'accès. NE JAMAIS écrire de valeur réelle ici : ce fichier est versionné.
MODELE_FOURNISSEUR_CLE=
# Nom du modèle demandé auprès de ce fournisseur.
MODELE_FOURNISSEUR_NOM=
# Libellé de l'organisme, pour la traçabilité (`extraction_element.moteur_*`).
MODELE_FOURNISSEUR_ORGANISME=
# Délai d'attente de l'appel, en secondes (défaut : 60).
MODELE_FOURNISSEUR_DELAI=60

# Langues passées à `tesseract` pour l'OCR des pages scannées (défaut : fra).
# Nécessite les données de langue correspondantes (`brew install tesseract-lang`).
OCR_LANGUES=fra
