# Ignorer les données locales et les secrets
data/
data-restaure/
# Donnees de verification (blobs chiffres d'un run de test) : hors depot.
verif-data/
.env
.env.*
# Exception : le modèle d'exemple est versionné (aucune valeur secrète dedans).
!.env.example
*.secret
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
build/

# OS
.DS_Store

# Divers
*.log
tmp/
.cache/

# Documents de consultation recus (jamais versionnes : ce sont des pieces d'acheteurs,
# pas des ressources du projet). Regle posee apres l'ajout accidentel d'un DCE reel
# dans docs/ (decision D10).
docs/Model de dossier de consultation/
docs/*dossier*consultation*/
